{
  "name": "forge-workspace",
  "productName": "Forge",
  "version": "3.2.6",
  "description": "Forge — a personal developer workspace for managing projects, work items, schedule and activity",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "test": "electron scripts/db-smoke.test.js",
    "verify:build": "node scripts/validate-build.js",
    "build:smoke": "node scripts/build-smoke.test.js",
    "dist": "npm run verify:build && electron-builder",
    "dist:win": "npm run verify:build && electron-builder --win",
    "dist:mac": "npm run verify:build && electron-builder --mac",
    "dist:linux": "npm run verify:build && electron-builder --linux",
    "dist:dir": "npm run verify:build && electron-builder --dir"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.forge.workspace",
    "productName": "Forge",
    "icon": "build/icon.ico",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "files": [
      "main.js",
      "ipc.js",
      "process-service.js",
      "store.js",
      "db.js",
      "backup.js",
      "preload.js",
      "renderer/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  }
}